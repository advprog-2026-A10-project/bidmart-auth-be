# Runtime
APP_ENV=development
APP_LOG_FORMAT=plain
RUST_LOG=info,bidmart_auth_be=debug,tower_http=info,sqlx=warn,axum=info

# Server Configuration
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8080

# Database Configuration
APP_DATABASE_URL=postgres://postgres:postgres@localhost:5432/bidmart_auth
# Default true for local DX; set false in production and run `cargo run --bin migrate` separately.
APP_AUTO_MIGRATE_ON_STARTUP=true

# Auth Policy (WBS-aligned)
APP_AUTH_MIN_PASSWORD_LENGTH=8
APP_AUTH_VERIFICATION_TOKEN_TTL_SECONDS=30
APP_AUTH_RESEND_COOLDOWN_SECONDS=30
APP_AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=30
APP_AUTH_PASSWORD_RESET_COOLDOWN_SECONDS=30
APP_AUTH_MFA_TICKET_TTL_SECONDS=300
APP_AUTH_EMAIL_MFA_CODE_TTL_SECONDS=30
APP_AUTH_EMAIL_MFA_COOLDOWN_SECONDS=30
APP_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
APP_AUTH_TOTP_SETUP_TTL_SECONDS=600

# JWT secret:
# - raw value with >= 32 bytes, or
# - base64 value with decoded length >= 32 bytes
APP_AUTH_JWT_SECRET=replace-with-at-least-32-bytes-of-key-material

# Email Delivery
# Allowed: resend | log
# In log mode, backend skips provider send and only logs dispatch events.
APP_EMAIL_DELIVERY_MODE=log
APP_RESEND_API_KEY=re_live_0123456789abcdef012345
APP_RESEND_FROM_EMAIL=BidMart <no-reply@updates.bidmart.com>

# Frontend links generated in email
APP_VERIFY_EMAIL_URL_BASE=http://localhost:5173/auth/verify-email?token=
APP_PASSWORD_RESET_URL_BASE=http://localhost:5173/auth/reset-password?token=

# Comma-separated browser origins allowed to call API with credentials
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173

# Session cookie configuration (hybrid cookie + bearer mode)
APP_AUTH_SESSION_COOKIE_NAME=auth_session
APP_AUTH_SESSION_COOKIE_SECURE=false
APP_AUTH_SESSION_COOKIE_SAME_SITE=Lax
# Optional. Use .bidmart.bid in deployed environments that need auth.bidmart.bid
# and api.auth.bidmart.bid to share the same browser session.
APP_AUTH_SESSION_COOKIE_DOMAIN=

# AMQP event publishing (optional, enable for runtime authz sync)
APP_AMQP_URL=amqp://bidmart:bidmart123@localhost:5672/
APP_AMQP_EXCHANGE=bidmart.domain.events

# Internal service auth for role/permission management endpoints
APP_INTERNAL_SERVICE_TOKEN=replace-with-strong-internal-token
