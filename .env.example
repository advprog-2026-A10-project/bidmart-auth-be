# Server Configuration
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8080

# Database Configuration
APP_DATABASE_URL=postgres://postgres:postgres@localhost:5432/bidmart_auth

# Auth Configuration
APP_AUTH_MIN_PASSWORD_LENGTH=8
APP_AUTH_VERIFICATION_TOKEN_TTL_SECONDS=30
APP_AUTH_RESEND_COOLDOWN_SECONDS=30

# Email Configuration
APP_RESEND_API_KEY=re_your_api_key
APP_RESEND_FROM_EMAIL=BidMart <no-reply@updates.bidmart.com>
APP_VERIFY_EMAIL_URL_BASE=https://sso.bidmart.com/verify-email?token=
