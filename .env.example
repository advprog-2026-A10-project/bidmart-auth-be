# Server Configuration
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8080

# Database Configuration
APP_DATABASE_URL=postgres://postgres:postgres@localhost:5432/bidmart_auth

# Auth Configuration
APP_AUTH_MIN_PASSWORD_LENGTH=8
APP_AUTH_VERIFICATION_TOKEN_TTL_SECONDS=30
APP_AUTH_RESEND_COOLDOWN_SECONDS=30
APP_AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=900
APP_AUTH_PASSWORD_RESET_COOLDOWN_SECONDS=30
APP_AUTH_MFA_TICKET_TTL_SECONDS=300
APP_AUTH_EMAIL_MFA_CODE_TTL_SECONDS=300
APP_AUTH_EMAIL_MFA_COOLDOWN_SECONDS=30
APP_AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
APP_AUTH_TOTP_SETUP_TTL_SECONDS=600
# Raw value with at least 32 bytes, or standard base64-encoded key material with at least 32 decoded bytes.
APP_AUTH_JWT_SECRET=replace-with-at-least-32-bytes-of-key-material

# Email Configuration
APP_RESEND_API_KEY=re_your_api_key
APP_RESEND_FROM_EMAIL=BidMart <no-reply@updates.bidmart.com>
APP_VERIFY_EMAIL_URL_BASE=https://sso.bidmart.com/verify-email?token=
APP_PASSWORD_RESET_URL_BASE=https://sso.bidmart.com/reset-password?token=

# Comma-separated browser origins allowed to call the API with Authorization headers.
APP_CORS_ALLOWED_ORIGINS=https://sso.bidmart.com,http://localhost:5173,http://127.0.0.1:5173
